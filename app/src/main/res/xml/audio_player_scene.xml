<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        android:id="@+id/mini_player_transition"
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@id/start"
        motion:duration="200"
        motion:motionInterpolator="easeInOut">
        <KeyFrameSet>
            <!-- the audio screen fades out early; only the artwork travels into the mini player -->
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="35"
                motion:motionTarget="@+id/audio_player_main" />
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="90"
                motion:motionTarget="@+id/miniPlayerControls" />
            <!-- the page's backdrop fades out with the audio screen and only comes back as the
                 mini player card at the very end, like the video player's page: otherwise a big
                 translucent panel shrinks along behind the artwork -->
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="35"
                motion:motionTarget="@+id/audio_player_container" />
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="90"
                motion:motionTarget="@+id/audio_player_container" />
        </KeyFrameSet>
        <!-- tapping the mini player expands it (in code, at the video player's speed) -->
        <!-- swipe down on the artwork to minimise (see SingleViewTouchableMotionLayout) -->
        <OnSwipe
            motion:dragDirection="dragDown"
            motion:maxAcceleration="40"
            motion:nestedScrollFlags="disableScroll"
            motion:onTouchUp="autoComplete"
            motion:touchAnchorId="@+id/audio_player_container"
            motion:touchAnchorSide="top" />
    </Transition>

    <ConstraintSet android:id="@+id/start">
        <!-- artwork: full width at the top (the status bar margin is set in code) -->
        <Constraint
            android:id="@+id/artwork_frame"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            motion:layout_constraintEnd_toEndOf="@id/audio_player_container"
            motion:layout_constraintStart_toStartOf="@id/audio_player_container"
            motion:layout_constraintTop_toTopOf="@id/audio_player_container" />
        <Constraint
            android:id="@+id/audio_player_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent" />
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <!-- artwork: shrunk into the mini player's thumbnail spot, flush left in the card -->
        <!-- exactly the card's height (the frame also holds the 88dp top gradient, which would
             otherwise make it taller than the card and centred off it); clipped in code -->
        <Constraint
            android:id="@+id/artwork_frame"
            android:layout_width="@dimen/mini_player_thumbnail_width"
            android:layout_height="0dp"
            motion:layout_constraintBottom_toBottomOf="@id/audio_player_container"
            motion:layout_constraintStart_toStartOf="@id/audio_player_container"
            motion:layout_constraintTop_toTopOf="@id/audio_player_container" />
        <!-- Mini player: a floating rounded card above the dock -->
        <Constraint
            android:id="@+id/audio_player_container"
            android:layout_width="0dp"
            android:layout_height="@dimen/mini_player_height"
            android:layout_marginStart="@dimen/mini_player_margin_horizontal"
            android:layout_marginEnd="@dimen/mini_player_margin_horizontal"
            android:layout_marginBottom="@dimen/mini_player_margin_bottom"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintHorizontal_bias="0.5"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintVertical_bias="1.0" />
        <Constraint
            android:id="@+id/audio_player_main"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:alpha="0"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/main_container" />
        <Constraint
            android:id="@+id/miniPlayerControls"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="1"
            android:paddingEnd="16dp"
            android:visibility="visible"
            motion:layout_constraintBottom_toBottomOf="@+id/audio_player_container"
            motion:layout_constraintEnd_toEndOf="@id/audio_player_container"
            motion:layout_constraintStart_toStartOf="@id/audio_player_container"
            motion:layout_constraintTop_toTopOf="@+id/audio_player_container" />
    </ConstraintSet>
</MotionScene>