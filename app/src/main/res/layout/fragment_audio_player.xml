<?xml version="1.0" encoding="utf-8"?>
<com.github.libretube.ui.views.SingleViewTouchableMotionLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerMotionLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layoutDescription="@xml/audio_player_scene">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/audio_player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bt_sheen_surface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Ambient backdrop: the artwork, blurred and faded behind everything -->
        <ImageView
            android:id="@+id/ambient_backdrop"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Keeps text readable on top of any artwork; replaced in code by a deep wash in the
             artwork's own colours -->
        <View
            android:id="@+id/ambient_scrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/ambient_scrim"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Fine grain over the gradients so they stay smooth (no banding) -->
        <View
            android:id="@+id/grain"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/audio_player_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/audio_player_container"
        app:layout_constraintEnd_toEndOf="@id/audio_player_container"
        app:layout_constraintStart_toStartOf="@id/audio_player_container"
        app:layout_constraintTop_toTopOf="@id/audio_player_container">

        <!-- Artwork in the same 16:9 slot as the video, with the top buttons floating on it,
             so switching between audio and video keeps the picture in place -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/artwork_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/black"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="16:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@tools:sample/backgrounds/scenic" />

            <!-- keeps the floating buttons visible on bright artwork -->
            <View
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:background="@drawable/audio_artwork_top_scrim"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/thumbnail" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/minimize_player"
                style="@style/AudioPlayerOverlayButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/minimize"
                app:icon="@drawable/ic_arrow_down"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/thumbnail" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/show_more"
                style="@style/AudioPlayerOverlayButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/more_options"
                app:icon="@drawable/ic_more_vert"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/thumbnail" />

            <!-- Switch back to video: on the picture it turns on -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_video"
                style="@style/AudioPlayerVideoPill"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:text="@string/video"
                app:icon="@drawable/ic_video"
                app:layout_constraintBottom_toBottomOf="@id/thumbnail"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/volumeControls"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:background="@drawable/controls_layout_bg"
                app:layout_constraintBottom_toBottomOf="@id/thumbnail"
                app:layout_constraintEnd_toEndOf="@id/thumbnail"
                app:layout_constraintStart_toStartOf="@id/thumbnail"
                app:layout_constraintTop_toTopOf="@id/thumbnail"
                android:orientation="vertical"
                android:visibility="gone"
                tools:ignore="RtlHardcoded">

                <TextView
                    android:id="@+id/volume_textView"
                    style="@style/SwipeControlString"
                    android:layout_gravity="center"
                    app:autoSizeTextType="uniform" />

                <ProgressBar
                    android:id="@+id/volume_progressBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="7dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_marginVertical="4dp"
                    android:progressDrawable="@drawable/vertical_progressbar" />

                <ImageView
                    android:id="@+id/volume_imageView"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/volume"
                    android:src="@drawable/ic_volume_up" />

            </LinearLayout>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress"
                style="@style/Spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:layout_constraintBottom_toBottomOf="@id/thumbnail"
                app:layout_constraintEnd_toEndOf="@id/thumbnail"
                app:layout_constraintStart_toStartOf="@id/thumbnail"
                app:layout_constraintTop_toTopOf="@id/thumbnail" />

            <include
                android:id="@+id/playback_error"
                layout="@layout/view_playback_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@id/thumbnail"
                app:layout_constraintEnd_toEndOf="@id/thumbnail"
                app:layout_constraintStart_toStartOf="@id/thumbnail"
                app:layout_constraintTop_toTopOf="@id/thumbnail" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Title: tap to show the description, like on the video page -->
        <LinearLayout
            android:id="@+id/title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:textAppearance="@style/PlayerPageTitle"
                tools:text="Mushrooms for Mind &amp; Immune System | Paul Stamets" />

            <ImageView
                android:id="@+id/description_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/description"
                android:src="@drawable/ic_arrow_down"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Current chapter (only when the video has chapters); opens the chapter list -->
        <TextView
            android:id="@+id/chapter_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:drawablePadding="2dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:textAppearance="@style/VideoMeta"
            android:visibility="gone"
            app:drawableEndCompat="@drawable/ic_heading_chevron"
            tools:text="Chapter 3: Mushrooms and the brain"
            tools:visibility="visible" />

        <!-- Controls centred between the title and Comments; the description opens on top.
             Nothing clips here, so the play button's glow isn't cut off -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.6" />

            <!-- Progress -->
            <com.google.android.material.slider.Slider
                android:id="@+id/time_bar"
                style="@style/AudioPlayerSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="12dp"
                app:labelBehavior="gone" />

            <!-- Times on the sides, data usage in the middle -->
            <FrameLayout
                android:id="@+id/times_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp">

                <com.github.libretube.ui.views.DataUsageView
                    android:id="@+id/data_usage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal" />

                <TextView
                    android:id="@+id/current_position"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="start|top"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="1:42:55" />

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="end|top"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="2:28:56" />

            </FrameLayout>

            <!-- equal space above and below the transport, between the progress bar and Comments -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="16dp" />

                <!-- Transport: fixed sizes so nothing shifts when pressed -->
            <LinearLayout
                android:id="@+id/transport_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rewindBTN"
                    style="@style/AudioPlayerSeekButton"
                    android:contentDescription="@string/rewind"
                    app:icon="@drawable/ic_rewind_md" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/play_pause"
                    style="@style/AudioPlayerPlayButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginHorizontal="32dp"
                    android:contentDescription="@string/play_pause"
                    app:icon="@drawable/ic_pause" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forwardBTN"
                    style="@style/AudioPlayerSeekButton"
                    android:contentDescription="@string/forward"
                    app:icon="@drawable/ic_forward_md" />

            </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="16dp" />

            <!-- Comments, as on the video page -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/comments_toggle"
                style="@style/CommentsTeaser"
                android:text="@string/comments"
                app:icon="@drawable/ic_arrow_up_down" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

            </LinearLayout>

            <!-- Description: a panel over the controls, closed again by tapping the title -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/description_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/audio_description_background"
                android:elevation="2dp"
                android:fadingEdgeLength="24dp"
                android:requiresFadingEdge="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textIsSelectable="true" />

            </androidx.core.widget.NestedScrollView>

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/miniPlayerControls"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:alpha="0"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/audio_player_container"
        app:layout_constraintEnd_toEndOf="@id/audio_player_container"
        app:layout_constraintStart_toStartOf="@id/audio_player_container"
        app:layout_constraintTop_toTopOf="@id/audio_player_container">

        <!-- edge to edge on the left; its left corners follow the card's (see MiniPlayerShape) -->
        <ImageView
            android:id="@+id/miniPlayerThumbnail"
            android:layout_width="@dimen/mini_player_thumbnail_width"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/miniPlayerTitle"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:paddingVertical="15dp" />

        <ImageView
            android:id="@+id/miniPlayerPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_pause" />

        <ImageView
            android:id="@+id/miniPlayerClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_close" />

    </LinearLayout>

    <!-- Fine rim around the mini player card, so it stands out from dark backgrounds
         (alpha follows the minimise progress, set in code) -->
    <View
        android:id="@+id/mini_rim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@drawable/mini_player_rim"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/audio_player_container"
        app:layout_constraintEnd_toEndOf="@id/audio_player_container"
        app:layout_constraintStart_toStartOf="@id/audio_player_container"
        app:layout_constraintTop_toTopOf="@id/audio_player_container" />

</com.github.libretube.ui.views.SingleViewTouchableMotionLayout>