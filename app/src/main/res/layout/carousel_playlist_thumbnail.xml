<?xml version="1.0" encoding="utf-8"?>
<!-- Playlist card in a plain horizontal row: the title sits on a soft gradient at the bottom of
     the artwork, so it stays readable on any image -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="212dp"
    android:layout_height="wrap_content"
    android:paddingHorizontal="6dp"
    android:stateListAnimator="@animator/press_scale">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/corner_thumbnail_large"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/playlist_placeholder"
                app:layout_constraintDimensionRatio="16:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- soft fade from clear to dark at the bottom, under the title only -->
            <View
                android:id="@+id/overlay_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/playlist_title_scrim"
                app:layout_constraintBottom_toBottomOf="@id/thumbnail"
                app:layout_constraintEnd_toEndOf="@id/thumbnail"
                app:layout_constraintHeight_percent="0.62"
                app:layout_constraintStart_toStartOf="@id/thumbnail" />

            <TextView
                android:id="@+id/playlistName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:shadowColor="#66000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@android:color/white"
                app:layout_constraintBottom_toBottomOf="@id/thumbnail"
                app:layout_constraintEnd_toEndOf="@id/thumbnail"
                app:layout_constraintStart_toStartOf="@id/thumbnail"
                tools:text="Playlist name" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
