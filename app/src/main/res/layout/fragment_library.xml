<?xml version="1.0" encoding="utf-8"?>
<!-- Library: playlists (carousel) and bookmarks at the top, then the watch history feed -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <com.github.libretube.ui.views.CustomSwipeToRefresh
        android:id="@+id/playlist_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/library_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_rise_in" />

    </com.github.libretube.ui.views.CustomSwipeToRefresh>

</FrameLayout>
