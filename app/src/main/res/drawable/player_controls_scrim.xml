<?xml version="1.0" encoding="utf-8"?>
<!-- Controls overlay: light overall tint, deeper gradients behind the top and bottom bars -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#33000000" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="#00000000"
                android:centerY="0.3"
                android:endColor="#00000000"
                android:startColor="#A6000000" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:centerColor="#00000000"
                android:centerY="0.35"
                android:endColor="#00000000"
                android:startColor="#B3000000" />
        </shape>
    </item>
</layer-list>
