<?xml version="1.0" encoding="utf-8"?>
<!-- Content softly fades out towards the bottom edge, so whatever scrolls behind the floating
     dock and mini player (e.g. a dark thumbnail) doesn't read as a bar behind them -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="90"
        android:centerColor="@color/bottom_fade"
        android:centerY="0.25"
        android:endColor="@android:color/transparent"
        android:startColor="@color/bottom_fade" />
</shape>
