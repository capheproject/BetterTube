<?xml version="1.0" encoding="utf-8"?>
<!-- Floating dock: opaque tonal surface with a soft colour sheen (accent flowing into a
     secondary tint), a gentle top highlight and a fine rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- opaque base -->
    <item>
        <shape>
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <!-- colour sheen -->
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:centerColor="@color/dock_tint_center"
                android:endColor="@color/dock_tint_end"
                android:startColor="@color/dock_tint_start" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <!-- top highlight -->
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="@android:color/transparent"
                android:centerY="0.5"
                android:endColor="@android:color/transparent"
                android:startColor="@color/dock_sheen" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <!-- rim -->
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/dock_edge" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</layer-list>
