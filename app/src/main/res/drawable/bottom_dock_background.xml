<?xml version="1.0" encoding="utf-8"?>
<!-- Floating dock with a glassy treatment: translucent tonal surface, a soft top sheen and a
     light-catching rim. Content scrolling underneath shows through faintly. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- translucent base -->
    <item>
        <shape>
            <solid android:color="@color/dock_surface" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <!-- top sheen -->
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="@android:color/transparent"
                android:centerY="0.55"
                android:endColor="@android:color/transparent"
                android:startColor="@color/dock_sheen" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <!-- rim -->
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/dock_edge" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</layer-list>
