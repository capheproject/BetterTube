<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="RoundedImageView">

        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_thumbnail</item>

    </style>

    <style name="CircleImageView">

        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>

    </style>

    <style name="AboutCard" parent="Widget.Material3.CardView.Filled">

        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardElevation">0dp</item>

    </style>

    <style name="AboutItem">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:drawablePadding">20dp</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
    </style>

    <style name="CustomDialogTextInputLayout" parent="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">15dp</item>
        <item name="android:layout_marginEnd">15dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">10dp</item>

    </style>

    <style name="DisabledTextInput">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:editable">false</item>
        <item name="android:textIsSelectable">true</item>

    </style>

    <style name="PlayerActionsButton" parent="SheenButton">

        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="iconGravity">textStart</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>

    </style>

    <style name="PlayerControlBottom">

        <item name="android:padding">9dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>

    </style>

    <style name="PlayerControlCenter">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:backgroundTint">@android:color/white</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
    </style>

    <style name="PlayerControlTop">

        <item name="android:padding">9dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@android:color/white</item>

    </style>

    <style name="WatchProgress">

        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:background">?colorPrimary</item>
        <item name="android:visibility">gone</item>

    </style>

    <style name="TimeString">
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="paddingStart">5dp</item>
        <item name="paddingEnd">5dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="fontFamily">@font/jakarta_semibold</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="SwipeControlString">
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lines">1</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:text">0</item>
    </style>

    <style name="Chip" parent="MinimalChip">

        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>

    </style>

    <style name="ItemRow">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:background">@drawable/rounded_ripple</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>

    </style>

    <!-- Uses Material Switches instead of the old ones -->
    <style name="Preference.SwitchPreferenceCompat.Material3" parent="@style/Preference.SwitchPreferenceCompat.Material">

        <item name="widgetLayout">@layout/view_preference_switch</item>
        <item name="singleLineTitle">false</item>

    </style>

    <style name="snackBarStyle" parent="@style/Widget.Material3.Snackbar">
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.ExtraLarge</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="maxLines">2</item>
        <item name="animationMode">slide</item>
    </style>

    <style name="HomeCategoryTitle">

        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="fontFamily">@font/jakarta_semibold</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">8dp</item>

    </style>

    <style name="TextViewMarquee">

        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
        <item name="android:scrollHorizontally">true</item>
        <item name="android:textAlignment">center</item>

    </style>

    <style name="ElevatedFilterChip" parent="MinimalChip">

        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>

    </style>

    <style name="Widget.Material3.Button.IconButton.Elevated" parent="Widget.Material3.Button.IconButton">
        <item name="android:stateListAnimator">@animator/m3_btn_elevated_btn_state_list_anim</item>
        <item name="elevation">@dimen/m3_comp_button_elevated_container_elevation</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material3Expressive.Button.Elevated</item>
    </style>

    <style name="AlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Material3.Button.TextButton.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Material3.Button.TextButton.Dialog</item>
    </style>

    <style name="PositiveButton" parent="AccentButton">
        <item name="android:layout_marginStart">16dp</item>
    </style>

    <!-- Slim, round-capped spinner that replaces the morphing "contained" loading indicator -->
    <style name="Spinner" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorSize">36dp</item>
        <item name="trackThickness">3.5dp</item>
        <item name="trackCornerRadius">2dp</item>
        <item name="indicatorColor">?attr/colorPrimary</item>
        <item name="trackColor">@android:color/transparent</item>
        <item name="indicatorTrackGapSize">0dp</item>
    </style>

    <!-- Spinner shown on top of video -->
    <style name="Spinner.OnMedia">
        <item name="indicatorColor">@android:color/white</item>
    </style>

    <!-- Slimmer bottom bar on a tonal surface -->
    <style name="BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">@dimen/dock_height</item>
        <item name="android:background">@drawable/bottom_dock_background</item>
        <item name="backgroundTint">@null</item>
        <item name="elevation">8dp</item>
        <item name="android:outlineAmbientShadowColor">#66000000</item>
        <item name="android:outlineSpotShadowColor">#66000000</item>
        <!-- the dock floats above the system bar: MainActivity applies the inset as a margin -->
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="itemPaddingTop">12dp</item>
        <item name="itemPaddingBottom">12dp</item>
        <item name="itemActiveIndicatorStyle">@style/DockIndicator</item>
        <item name="itemIconTint">@color/dock_icon</item>
        <item name="itemBackground">@drawable/dock_item_glow</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="itemTextAppearanceActive">@style/BottomNavLabel</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavLabel</item>
    </style>

    <style name="DockIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">56dp</item>
        <item name="android:height">40dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <!-- no pill: the selected tab glows instead (see dock_item_glow) -->
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="BottomNavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="fontFamily">@font/jakarta_semibold</item>
    </style>

    <style name="AppToolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/AppToolbarTitle</item>
    </style>

    <style name="AppToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="fontFamily">@font/jakarta_bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <!-- Titles of videos in lists and feeds -->
    <style name="VideoTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="fontFamily">@font/jakarta_semibold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="VideoTitle.Small" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="fontFamily">@font/jakarta_semibold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="DurationBadge" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="fontFamily">@font/jakarta_semibold</item>
        <item name="android:textColor">@color/duration_text_color</item>
    </style>


    <!-- Minimal audio player -->
    <style name="AudioPlayerArtwork">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="AudioPlayerTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="fontFamily">@font/jakarta_semibold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Thin progress bar with a slim thumb -->
    <style name="AudioPlayerSlider" parent="Widget.Material3.Slider">
        <item name="trackHeight">4dp</item>
        <item name="thumbWidth">4dp</item>
        <item name="thumbHeight">20dp</item>
        <item name="thumbTrackGapSize">4dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="trackInsideCornerSize">2dp</item>
        <item name="tickVisibilityMode">hidden</item>
    </style>

    <!-- Plain icon button (non-expressive, so it never changes shape or size when pressed) -->
    <style name="AudioPlayerSeekButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="iconSize">30dp</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="AudioPlayerTopButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="iconSize">24dp</item>
    </style>

    <!-- Fixed-size round play/pause button -->
    <style name="AudioPlayerPlayButton" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="android:background">@drawable/bt_accent_circle</item>
        <item name="backgroundTint">@null</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="iconSize">34dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <style name="AudioPlayerQuickAction" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">8dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="iconSize">20dp</item>
    </style>

    <!-- Compact Library shortcuts (watch history, downloads) -->
    <style name="LibraryShortcut" parent="Widget.Material3.Button.TonalButton.Icon">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="iconSize">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <!-- ===== Minimal design system ===== -->

    <!-- Primary action: the accent gradient shared with the mini player, dock and chips -->
    <style name="AccentButton" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bt_accent_pill</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
    </style>

    <style name="AccentButton.Icon" parent="AccentButton">
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Secondary action: darker tonal surface with the faint accent wash -->
    <style name="SheenButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:background">@drawable/bt_sheen_pill</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorPrimary</item>
    </style>

    <style name="SheenButton.Icon" parent="SheenButton">
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Flat filter chip: no outline, no elevation, no check mark; selection shown by colour -->
    <style name="MinimalChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipBackgroundColor">@color/minimal_chip_background</item>
        <item name="android:textColor">@color/minimal_chip_text</item>
        <item name="chipIconTint">@color/minimal_chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <!-- Tabs: left-aligned, compact, short indicator -->
    <style name="MinimalTabs" parent="Widget.Material3.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabMode">scrollable</item>
        <item name="tabGravity">start</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabPaddingStart">12dp</item>
        <item name="tabPaddingEnd">12dp</item>
        <item name="tabTextAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="tabSelectedTextColor">?attr/colorOnSurface</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="tabIndicatorColor">?attr/colorOnSurface</item>
        <item name="tabContentStart">4dp</item>
    </style>

    <!-- Video title on the player page -->
    <style name="PlayerPageTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="fontFamily">@font/jakarta_semibold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- "Comments" entry on the player page: a quiet full-width row -->
    <style name="CommentsTeaser" parent="Widget.Material3.Button.TonalButton.Icon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="android:layout_marginVertical">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:background">@drawable/bt_sheen_card</item>
        <item name="backgroundTint">@null</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">end</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="ChannelBannerShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Quiet empty states -->
    <style name="EmptyStateText">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Plain icon button used in headers/toolbars inside screens -->
    <style name="MinimalIconButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Low-emphasis text button with a leading icon -->
    <style name="MinimalTextButton" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <!-- Settings screens -->
    <style name="BT.PreferenceTheme" parent="PreferenceThemeOverlay">
        <item name="preferenceCategoryTitleTextAppearance">@style/BT.PreferenceCategoryTitle</item>
        <item name="preferenceCategoryTitleTextColor">?attr/colorPrimary</item>
    </style>

    <style name="BT.PreferenceCategoryTitle" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="fontFamily">@font/jakarta_semibold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

</resources>